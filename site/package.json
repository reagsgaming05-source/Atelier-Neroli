{
  "name": "aktum-pdf",
  "version": "0.1.0",
  "private": true,
  "description": "Site et espace client d’Aktum PDF — abonnements, licences, facturation, administration.",
  "scripts": {
    "predev": "tsx scripts/ensure-db.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/ensure-db.ts",
    "build": "next build",
    "prestart": "tsx scripts/ensure-db.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:generate": "drizzle-kit generate",
    "test": "tsx --test \"test/*.test.ts\"",
    "e2e": "node test/parcours-offre.mjs",
    "vitrine": "node test/figer.mjs && node test/un-seul-fichier.mjs",
    "captures": "node test/captures-du-site.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "next": "16.4.0",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
