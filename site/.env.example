# ---------------------------------------------------------------------------
# En local : une base SQLite dans un fichier, créée au premier lancement.
# ---------------------------------------------------------------------------
DATABASE_URL=file:./data/blonay-pdf.db

# ---------------------------------------------------------------------------
# En ligne (Vercel, ou tout hébergement sans serveur) : une base distante.
# Un hébergement sans serveur n'a pas de disque persistant — une base en
# fichier y serait perdue d'une requête à l'autre. L'application refuse de
# démarrer dans ce cas plutôt que de perdre vos offres et vos factures.
#
# DATABASE_URL=libsql://votre-base.turso.io
# DATABASE_AUTH_TOKEN=le-jeton-donné-par-turso
# ---------------------------------------------------------------------------

# Compte administrateur créé au premier démarrage.
# ⚠️ ADMIN_PASSWORD est OBLIGATOIRE en production : le mot de passe par défaut
# ci-dessous est écrit dans un dépôt public.
ADMIN_EMAIL=admin@blonaypdf.ch
ADMIN_PASSWORD=BlonayPDF-Admin-2026!

# Adresse publique du site, pour les métadonnées et les liens absolus.
# SITE_URL=https://blonaypdf.vercel.app

# Crée les comptes et les factures de démonstration. Automatique en
# développement ; à poser explicitement si vous les voulez aussi en ligne
# (démonstration commerciale). Ne pas laisser sur un site qui vend vraiment.
# SEED_DEMO=1

# Autorise une base en fichier alors que NODE_ENV=production : uniquement si
# vous hébergez vous-même, sur une machine avec un vrai disque.
# BLONAY_FICHIER_EN_PROD=1

# ---------------------------------------------------------------------------
# Qui vend. Le dépôt est public : rien de ceci n'y figure. Tant que ces
# variables manquent, le site n'affiche aucune identité et REFUSE d'émettre une
# offre ou une facture (une facture est un acte juridique).
# ---------------------------------------------------------------------------
# EDITEUR_NOM=
# EDITEUR_RUE=
# EDITEUR_NUMERO=
# EDITEUR_NPA=
# EDITEUR_LOCALITE=
# EDITEUR_CANTON=
# EDITEUR_IDE=CHE-123.456.789
# EDITEUR_IBAN=
# EDITEUR_EMAIL=
# EDITEUR_EMAIL_SUPPORT=
# EDITEUR_TELEPHONE=
# À poser seulement une fois assujetti à la TVA :
# EDITEUR_TVA=

# ---------------------------------------------------------------------------
# Courriel : l'offre qui part chez le client, la confirmation de commande, la
# licence en pièce jointe, les messages de contact. Sans ces variables, le site
# n'envoie RIEN et le dit à l'administration (« courriel non envoyé »).
# Le mot de passe SMTP est une variable de l'hébergement, jamais du dépôt.
# ---------------------------------------------------------------------------
# MAIL_SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.ch:465
# MAIL_DE=Nom de l'éditeur <ne-pas-repondre@exemple.ch>

# ---------------------------------------------------------------------------
# Paiement par carte : FERMÉ en production tant qu'aucun prestataire réel n'est
# branché. Le seul chemin d'achat ouvert est « demander une offre, puis payer
# la facture QR à 30 jours », qui est réel. Le mode démonstration (cartes
# fictives, aucun débit) ne s'ouvre qu'ici, explicitement, et jamais en production.
# ---------------------------------------------------------------------------
# PAIEMENT_MODE=demo
