{
  "name": "blonay-pdf-desktop",
  "version": "2.1.0",
  "description": "Blonay PDF – application fenêtrée (version portable, sans installation)",
  "main": "main.js",
  "private": true,
  "author": "Atelier Neroli",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/reagsgaming05-source/Atelier-Neroli.git"
  },
  "scripts": {
    "prepare-app": "node prepare-app.js",
    "start": "npm run prepare-app && electron .",
    "dist:win": "npm run prepare-app && electron-builder --win dir",
    "dist:linux": "npm run prepare-app && electron-builder --linux dir",
    "smoke": "node smoke-test.js",
    "comptes": "node comptes-test.js",
    "ecrasement": "node ecrasement-test.js",
    "reseau": "node reseau-test.js",
    "maj": "node maj-test.js",
    "dist:mac": "npm run prepare-app && electron-builder --mac dir --universal"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "playwright-core": "^1.49.1"
  },
  "build": {
    "appId": "ch.atelier-neroli.blonay-pdf",
    "productName": "BlonayPDF",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "ou-ranger.js",
      "version-posee.js",
      "verrou.js",
      "signature.js",
      "verifier-maj.js",
      "cles-publiques.json",
      "comptes.js",
      "preload.js",
      "choix-preload.js",
      "choix-profil.html",
      "app/**",
      "build/icon.png",
      "build/icon.ico",
      "build/icon-1024.png",
      "build/entitlements.mac.plist"
    ],
    "asar": true,
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "electronDownload": {
      "cache": ".electron-cache"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-1024.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": false
    }
  }
}
