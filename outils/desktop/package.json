{
  "name": "blonay-pdf-desktop",
  "version": "2.0.0",
  "description": "Blonay PDF – application fenêtrée (version portable, sans installation)",
  "main": "main.js",
  "private": true,
  "author": "Atelier Neroli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reagsgaming05-source/Atelier-Neroli.git"
  },
  "scripts": {
    "prepare-app": "node prepare-app.js",
    "start": "npm run prepare-app && electron .",
    "dist:win": "npm run prepare-app && electron-builder --win dir",
    "dist:linux": "npm run prepare-app && electron-builder --linux dir",
    "smoke": "node smoke-test.js",
    "comptes": "node comptes-test.js"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "playwright-core": "^1.49.1"
  },
  "build": {
    "appId": "ch.atelier-neroli.blonay-pdf",
    "productName": "BlonayPDF",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "ou-ranger.js",
      "comptes.js",
      "preload.js",
      "choix-preload.js",
      "choix-profil.html",
      "app/**",
      "build/icon.png",
      "build/icon.ico"
    ],
    "asar": true,
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "electronDownload": {
      "cache": ".electron-cache"
    }
  }
}
