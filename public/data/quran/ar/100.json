["وَٱلۡعَـٰدِیَـٰتِ ضَبۡحࣰا","فَٱلۡمُورِیَـٰتِ قَدۡحࣰا","فَٱلۡمُغِیرَ ٰ⁠تِ صُبۡحࣰا","فَأَثَرۡنَ بِهِۦ نَقۡعࣰا","فَوَسَطۡنَ بِهِۦ جَمۡعًا","إِنَّ ٱلۡإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودࣱ","وَإِنَّهُۥ عَلَىٰ ذَ ٰ⁠لِكَ لَشَهِیدࣱ","وَإِنَّهُۥ لِحُبِّ ٱلۡخَیۡرِ لَشَدِیدٌ","۞ أَفَلَا یَعۡلَمُ إِذَا بُعۡثِرَ مَا فِی ٱلۡقُبُورِ","وَحُصِّلَ مَا فِی ٱلصُّدُورِ","إِنَّ رَبَّهُم بِهِمۡ یَوۡمَىِٕذࣲ لَّخَبِیرُۢ"]